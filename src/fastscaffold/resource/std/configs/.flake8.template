[flake8]
per-file-ignores =
    src/{{ slug }}/config.py: WPS432
    # magic numbers in config are labelled, so it's ok
    src/{{ slug }}/bootstrap/di/**.py: WPS201, WPS347
    # it's bootstrap so many imports is ok.
    # vague imports are ok, they are parts of DSL
    src/{{ slug }}/bootstrap/**.py: WPS201
    # it's bootstrap so many imports is ok.

ignore =
    F401, W503
    # Covered by ruff

exclude =
    src/{{ slug }}/infrastructure/persistence/migrations/**.py
    src/{{ slug }}/infrastructure/migrations/**.py

allowed-domain-names =
    data
    # litestar is name-sensitive, alas :(

max-imports = 20
