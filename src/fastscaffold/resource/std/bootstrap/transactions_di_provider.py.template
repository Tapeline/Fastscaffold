from collections.abc import AsyncIterable

from dishka import Provider, Scope, WithParents, provide
from sqlalchemy.ext.asyncio import AsyncSession, async_sessionmaker

from {{slug}}.config import Config
from {{slug}}.infrastructure.persistence.database import new_session_maker
from {{slug}}.infrastructure.persistence.transactions import SATransactionManager


class TransactionManagerDIProvider(Provider):
    """Provides sessions and TransactionManagers."""

    @provide(scope=Scope.APP)
    def get_session_maker(
        self, config: Config
    ) -> async_sessionmaker[AsyncSession]:
        """Provide app session maker."""
        return new_session_maker(config.postgres)

    @provide(scope=Scope.REQUEST)
    async def get_transaction(
        self,
        session_maker: async_sessionmaker[AsyncSession]
    ) -> AsyncIterable[WithParents[SATransactionManager]]:
        """Provide TransactionManager."""
        async with session_maker() as session:
            yield SATransactionManager(session)
