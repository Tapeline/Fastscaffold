from dataclasses import dataclass
from typing import final

from structlog import getLogger

from {{slug}}.application.auth.auth import UserCredentialStore
from {{slug}}.application.identifier import UUIDGenerator
from {{slug}}.application.persistence.transactions import TransactionManager

{{user.import_line}}

logger = getLogger(__name__)


@dataclass
@final
class RegisterInteractor:
    """Register a user."""

    user_cred_store: UserCredentialStore
    id_gen: UUIDGenerator
    transaction: TransactionManager

    async def __call__(
        self,
        username: str,
        password: str
    ) -> User:
        async with self.transaction:
            user = User(
                id=UserId(self.id_gen()),
                username=username,
            )
            await self.user_cred_store.register_user(user, password)
            logger.info("Registered user", username=username, id=user.id)
            return user
