from dataclasses import dataclass
from typing import final

from structlog import getLogger

from {{slug}}.application.auth.auth import (
    AuthSession,
    UserCredentialStore,
)
from {{slug}}.application.auth.exceptions import UserCredsNotFound
from {{slug}}.application.persistence.transactions import TransactionManager

logger = getLogger(__name__)


@dataclass
@final
class LoginInteractor:
    """Login a user and return auth token."""

    user_cred_store: UserCredentialStore
    transaction: TransactionManager

    async def __call__(
        self,
        username: str,
        password: str
    ) -> AuthSession:
        """Call."""
        logger.info("Attempting login for user", username=username)
        async with self.transaction:
            user_id = await self.user_cred_store.login_user(
                username, password
            )
            if not user_id:
                logger.info("Login failed for user", username=username)
                raise UserCredsNotFound
            logger.info("Creating session for user", username=username)
            return await self.user_cred_store.generate_session(user_id)
