import secrets
from typing import Final, override

import argon2
from argon2.exceptions import VerifyMismatchError

from {{slug}}.infrastructure.persistence.auth import (
    AuthTokenGenerator,
    PasswordHashComparator,
    PasswordHasher,
)

_AUTH_TOKEN_BYTE_LEN: Final = 32


class ArgonSecurity(PasswordHasher, PasswordHashComparator, AuthTokenGenerator):
    """Impl."""

    @override
    def hash(self, password: str) -> str:
        return argon2.hash_password(password.encode()).decode()

    @override
    def compare(self, hashed: str, password: str) -> bool:
        try:
            return argon2.verify_password(hashed.encode(), password.encode())
        except VerifyMismatchError:
            return False

    @override
    def gen_token(self) -> str:
        return secrets.token_hex(_AUTH_TOKEN_BYTE_LEN)
